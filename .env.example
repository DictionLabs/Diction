# Diction -- Self-Hosted Whisper
#
# This file is optional. The docker-compose.yml works without it.
# Copy to .env if you want to customize settings.
#
# No configuration needed for basic usage -- just run:
#   docker compose up -d whisper-small

# --- AI Enhancement (BYO LLM) ---
# Uncomment to connect a local or cloud LLM for transcript cleanup and voice editing.
# Both LLM_BASE_URL and LLM_MODEL are required; all other vars below are optional.
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# Override any prompt. Leave unset to use the built-in default.
# LLM_PROMPT=You are a transcript cleanup tool. Fix grammar, punctuation, and remove filler words. Return only the corrected text, nothing else.
# LLM_PROMPT_EDIT=You are a text editor. Apply the user's spoken instruction to the text. Return only the edited result, nothing else.
# LLM_PROMPT_EDIT_SELECTED=You are a text editor. Apply the user's spoken instruction to the selected portion of text. Return only the edited selection, nothing else.
# LLM_PROMPT_SUGGEST=Suggest 2-3 concise alternative phrasings or corrections for the selected text. Return a JSON array of strings only, no explanation.
# LLM_PROMPT_FORMATTING is appended to LLM_PROMPT when the client asks for formatting.
# LLM_PROMPT_FORMATTING=
# LLM_PROMPT_SUMMARY backs /v1/text/summarize (one-line note summaries).
# LLM_PROMPT_SUMMARY=

# Set to true to open /v1/text/* routes (required for voice editing and suggestions).
# Leave false if you do not use the text routes.
# TEXT_ROUTES_OPEN=true
